{
  "name": "testtalon-community",
  "version": "3.0.0",
  "private": true,
  "description": "TestTalon Community Web GUI automation and shared test-data helpers",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node packages/core/scripts/resolve-dist-aliases.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:tests": "node packages/community/distribution/lint.cjs",
    "locator:extract": "node packages/web/scripts/extract-locators.js",
    "test:unit": "node --test packages/core/tests/*.test.cjs packages/web/tests/unit/*.test.cjs packages/reporting/custom/*.test.cjs",
    "test:list": "playwright test --list --project=dev",
    "test:smoke": "playwright test --project=dev --retries=0 tests/sample/webapp/functional/community/browser.test.ts",
    "test:web": "playwright test --project=dev --retries=0 --grep @Offline",
    "test:online": "playwright test --project=dev --retries=0 --grep @Online",
    "test": "npm run build && npm run test:unit && npm run test:smoke",
    "showreport": "playwright show-report logs/html-report",
    "lint": "npm run lint:tests"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "1.52.0",
    "@faker-js/faker": "10.6.0",
    "crypto-js": "4.2.0",
    "csv-parse": "7.0.3",
    "exceljs": "3.10.0",
    "pdfjs-dist-es5": "2.13.216",
    "playwright": "1.63.0",
    "strip-ansi": "6.0.1",
    "winston": "3.18.3",
    "winston-daily-rotate-file": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/crypto-js": "4.2.2",
    "@types/node": "24.10.1",
    "typescript": "6.0.2"
  }
}
