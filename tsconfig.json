{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "paths": {
      "@config/*": [
        "./config/*"
      ],
      "@data/*": [
        "./data/*"
      ],
      "@packages/*": [
        "./packages/*"
      ],
      "@objectRepositories/*": [
        "./object-repositories/*"
      ]
    },
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/core/**/*.ts",
    "packages/web/**/*.ts",
    "config/**/*.ts",
    "packages/community/config/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "packages/reporting/custom/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "logs"
  ]
}
