{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmitOnError": true,
    "paths": {
      "@core/lib/BaseTest": [
        "./packages/community/lib/BaseTest.ts"
      ],
      "@core/lib/WebActions": [
        "./packages/community/lib/WebActions.ts"
      ],
      "@core/lib/CommonFuncs": [
        "./packages/community/lib/CommonFuncs.ts"
      ],
      "@core/lib/GenerateData": [
        "./core/lib/GenerateData.ts"
      ],
      "@config/*": [
        "./config/*"
      ],
      "@objectRepositories/*": [
        "./objectRepositories/*"
      ]
    }
  },
  "include": [
    "packages/community/lib/**/*.ts",
    "config/**/*.ts",
    "core/lib/GenerateData.ts",
    "tests/**/*.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "logs"
  ]
}
