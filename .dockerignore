# Docker build context exclusions for TestTalon Community.
# Key material never enters the image. The profiles in config/project-profiles stay, because the tests read them: keep real
# credentials encrypted with dotenvx, or mount your own profile at run time (see the Dockerfile).
**/.env.keys
**/*.pem
**/*.key
**/*.crt
**/*.cert
**/*.p12
**/*.pfx
**/*.secret*
playwright/.auth

# Version control and editor folders
.git
.github
.gitignore
.gitattributes
.vscode
**/.DS_Store

# Dependencies and generated output (rebuilt in the image)
**/node_modules
dist
logs
test-results
allure-results
allure-report
playwright-report
blob-report
html-report*
coverage
**/*.log
